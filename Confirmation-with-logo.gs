const SHEET_ID = '1nuWzqRYEjuBOJSH7K6HZWb9tIG5jcNAXn-M2yUvz6rE';
const SHEET_NAME = 'การตอบแบบฟอร์ม 1';
const WEB_APP_URL = 'https://script.google.com/macros/s/AKfycbwcqCXdaHgyOErv8s-5uHjrP-I9ikvIYMH-n7yYwWTI-6GZ8pJaVuAC_fQ0r5UeUR-i3A/exec';

function getSheet_() {
  const sheet = SpreadsheetApp.openById(SHEET_ID).getSheetByName(SHEET_NAME);
  if (!sheet) throw new Error('Sheet not found: ' + SHEET_NAME);
  return sheet;
}

function generateConfirmationLinks() {
  if (Session.getActiveUser().getEmail() !== 'gartoon2549n@gmail.com') {
    throw new Error('Only the project owner can generate confirmation links.');
  }
  createConfirmationLinks_();
}

function createConfirmationLinks_() {
  const lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    const sheet = getSheet_();
    const expected = ['Confirmation Status', 'Confirmed At', 'Confirmation Token'];
    const headers = sheet.getRange(1, 18, 1, 3).getDisplayValues()[0];
    if (headers.some((v, i) => v.trim() !== expected[i])) {
      throw new Error('Please check the headers in columns R, S and T.');
    }
    const header = sheet.getRange('U1').getDisplayValue().trim();
    if (header && header !== 'Confirmation Link') {
      throw new Error('Column U already contains other data.');
    }
    sheet.getRange('U1').setValue('Confirmation Link');
    const last = sheet.getLastRow();
    if (last < 2) return;
    const rows = sheet.getRange(2, 1, last - 1, 20).getDisplayValues();
    rows.forEach((row, i) => {
      if (!(row[15].trim() || row[2].trim())) return;
      const token = row[19].trim() || Utilities.getUuid();
      if (!row[17].trim()) sheet.getRange(i + 2, 18).setValue('Pending');
      sheet.getRange(i + 2, 20).setValue(token);
      sheet.getRange(i + 2, 21).setValue(WEB_APP_URL + '?token=' + encodeURIComponent(token));
    });
  } finally {
    lock.releaseLock();
  }
}

function doGet(e) {
  const token = String(e?.parameter?.token || '');
  if (!/^[0-9a-f-]{36}$/i.test(token)) {
    return HtmlService.createHtmlOutput('<h2>Invalid confirmation link.</h2><p>Please use the link in your invitation email.</p>');
  }
  return HtmlService.createHtmlOutput(`
    <!DOCTYPE html>
    <html lang="en">
    <head>
      <meta charset="UTF-8">
      <meta name="viewport" content="width=device-width, initial-scale=1">
      <style>
        body { margin:0; padding:40px 20px; background:#f4f7fc; color:#17233b; font-family:Arial,sans-serif; text-align:center; }
        .card { max-width:520px; margin:0 auto; padding:32px 24px; background:white; border-radius:16px; }
        h1 { font-size:24px; line-height:1.4; }
        p { line-height:1.6; }
        button { padding:16px 28px; border:0; border-radius:8px; background:#0f62fe; color:white; font-size:17px; cursor:pointer; }
        button:disabled { opacity:0.6; cursor:wait; }
        #message { margin-top:24px; }
      </style>
    </head>
    <body>
      <main class="card">
        <img src="data:image/png;base64," alt="Qiskit Fall Fest 2026 logo" style="width:160px;max-width:100%;height:auto;margin-bottom:16px;">
        <h1>Qiskit Fall Fest 2026: Thailand</h1>
        <p>Click the button below to confirm your participation.</p>
        <button id="confirmButton" onclick="confirmNow()">Confirm participation</button>
        <p id="message" role="status" aria-live="polite"></p>
      </main>
      <script>
        function confirmNow() {
          const button = document.getElementById('confirmButton');
          const message = document.getElementById('message');
          button.disabled = true;
          message.textContent = 'Saving your confirmation…';
          google.script.run
            .withSuccessHandler(function(result) {
              message.textContent = result;
              button.style.display = 'none';
            })
            .withFailureHandler(function() {
              message.textContent = 'Unable to save your confirmation. Please try again or contact the organizers.';
              button.disabled = false;
            })
            .confirmRegistration(${JSON.stringify(token)});
        }
      </script>
    </body>
    </html>
  `).setTitle('Confirm participation');
}

function confirmRegistration(token) {
  if (typeof token !== 'string' || !/^[0-9a-f-]{36}$/i.test(token)) {
    throw new Error('Invalid confirmation token.');
  }
  const lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    const sheet = getSheet_();
    const last = sheet.getLastRow();
    if (last < 2) throw new Error('Registration not found.');
    const matches = sheet.getRange(2, 20, last - 1, 1)
      .createTextFinder(token).matchEntireCell(true).matchCase(true)
      .useRegularExpression(false).findAll();
    if (matches.length !== 1) throw new Error('Registration not found or duplicate token.');
    const row = matches[0].getRow();
    if (sheet.getRange(row, 18).getValue() === 'Confirmed') {
      return 'Your participation has already been confirmed. Thank you!';
    }
    sheet.getRange(row, 18, 1, 2).setValues([['Confirmed', new Date()]]);
    return 'Your participation has been confirmed successfully. Thank you!';
  } finally {
    lock.releaseLock();
  }
}

// Select this function when creating the spreadsheet form-submit trigger.
function onRegistrationSubmitted(e) {
  if (!e || !e.range) return;
  const submittedSheet = e.range.getSheet();
  if (submittedSheet.getParent().getId() !== SHEET_ID) return;
  if (submittedSheet.getName() !== SHEET_NAME) return;
  createConfirmationLinks_();
}